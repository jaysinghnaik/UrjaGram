# UrjaGram Environment Configuration

# Supabase (Optional for local development — falls back to local sample data if omitted)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Gemini API Key (Free tier available at https://aistudio.google.com/)
VITE_GEMINI_API_KEY=

# GEE Backend URL (Optional — defaults to http://localhost:8000)
VITE_GEE_BACKEND_URL=http://localhost:8000
